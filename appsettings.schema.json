{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"ConnectionStrings": {
			"type": "object",
			"properties": {
				"CloudDb": {
					"type": "object",
					"description": "Cadena de conexión para la base de datos en la nube",
					"properties": {
						"Provider": {
							"type": "string",
							"description": "Proveedor de la base de datos en la nube (e.g., 'SqlServer', 'PostgreSql')"
						},
						"ConnectionString": {
							"type": "string",
							"description": "Cadena de conexión completa para la base de datos en la nube"
						}
					},
					"required": ["Provider", "ConnectionString"]
				},
				"LocalDb": {
					"type": "object",
					"description": "Cadena de conexión para la base de datos local",
					"properties": {
						"Provider": {
							"type": "string",
							"description": "Proveedor de la base de datos local (e.g., 'SqlServer', 'PostgreSql')"
						},
						"ConnectionString": {
							"type": "string",
							"description": "Cadena de conexión completa para la base de datos local"
						}
					},
					"required": ["Provider", "ConnectionString"]
				}
			},
			"required": ["CloudDb", "LocalDb"]
		},
		"Synchronization": {
			"type": "object",
			"properties": {
				"PollingIntervalSeconds": {
					"type": "integer",
					"minimum": 5,
					"maximum": 3600,
					"description": "Intervalo de polling en segundos (5-3600)"
				},
				"ProcessingVersion": {
					"type": "integer",
					"minimum": 1,
					"description": "Versión del worker"
				},
				"LocalToCloud": {
					"type": "object",
					"description": "propiedades del flujo LocalToCloud",
					"properties": {
						"CanUpdate": {
							"type": "boolean",
							"description": "Indica si se puede ejecutar UPDATE en la base de datos en la nube"
						},
						"CanDelete": {
							"type": "boolean",
							"description": "Indica si se puede ejecutar DELETE en la base de datos en la nube"
						}
					}
				},
				"CloudToLocal": {
					"type": "object",
					"description": "propiedades del flujo CloudToLocal",
					"properties": {
						"CanUpdate": {
							"type": "boolean",
							"description": "Indica si se puede ejecutar UPDATE en la base de datos local"
						},
						"CanDelete": {
							"type": "boolean",
							"description": "Indica si se puede ejecutar DELETE en la base de datos local"
						}
					}
				},
				"UseSnapshotIsolation": {
					"type": "boolean",
					"description": "Indica si se debe usar aislamiento de snapshot en las transacciones"
				},
				"StringReplacements": {
					"type": "array",
					"description": "Lista de reemplazos de cadenas a aplicar a los eventos entrantes",
					"items": {
						"type": "object",
						"properties": {
							"OldValue": {
								"type": "string",
								"description": "Valor antiguo a reemplazar"
							},
							"NewValue": {
								"type": "string",
								"description": "Valor nuevo que reemplazará al antiguo"
							}
						},
						"required": ["OldValue", "NewValue"]
					}
				}
			},
			"required": ["LocalToCloud", "CloudToLocal", "UseSnapshotIsolation"]
		},
		"Serilog": {
			"type": "object",
			"properties": {
				"MinimumLevel": {
					"type": "object",
					"properties": {
						"Override": {
							"type": "object",
							"patternProperties": {
								".*": {
									"type": "string",
									"enum": [
										"Verbose",
										"Debug",
										"Information",
										"Warning",
										"Error",
										"Fatal"
									]
								}
							}
						}
					}
				}
			}
		},
		"Monitoring": {
			"type": "object",
			"properties": {
				"Sentry": {
					"type": "string",
					"description": "DSN de Sentry"
				},
				"ApplicationInsights": {
					"type": "string",
					"description": "Cadena de conexión para Application Insights"
				},
				"HealthcheksIo": {
					"type": "string",
					"description": "URL de ping para Healthchecks.io"
				}
			}
		},
		"Service": {
			"type": "object",
			"properties": {
				"ServiceName": {
					"type": "string",
					"description": "Nombre del servicio"
				}
			},
			"required": ["ServiceName"]
		}
	},
	"required": ["ConnectionStrings", "Synchronization", "Service"],
	"additionalProperties": false
}
