{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"ConnectionStrings": {
			"type": "object",
			"properties": {
				"CloudDb": {
					"type": "string",
					"description": "Cadena de conexión para la base de datos en la nube"
				},
				"LocalDb": {
					"type": "string",
					"description": "Cadena de conexión para la base de datos local"
				}
			},
			"required": ["CloudDb", "LocalDb"]
		},
		"APPLICATIONINSIGHTS_CONNECTION_STRING": {
			"type": "string",
			"description": "Cadena de conexión para Application Insights"
		},
		"SyncSettings": {
			"type": "object",
			"properties": {
				"PollingIntervalSeconds": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3600,
					"description": "Intervalo de polling en segundos (1-3600)"
				},
				"ProcessingVersion": {
					"type": "integer",
					"minimum": 1,
					"description": "Versión del worker"
				}
			},
			"required": ["PollingIntervalSeconds"]
		},
		"Serilog": {
			"type": "object",
			"properties": {
				"MinimumLevel": {
					"type": "object",
					"properties": {
						"Override": {
							"type": "object",
							"patternProperties": {
								".*": {
									"type": "string",
									"enum": [
										"Verbose",
										"Debug",
										"Information",
										"Warning",
										"Error",
										"Fatal"
									]
								}
							}
						}
					}
				}
			}
		},
		"Sentry": {
			"type": "object",
			"properties": {
				"Dsn": {
					"type": "string",
					"description": "DSN de Sentry"
				}
			},
			"required": ["Dsn"]
		}
	},
	"required": ["ConnectionStrings", "SyncSettings"],
	"additionalProperties": false
}
